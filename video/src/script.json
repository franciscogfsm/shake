      "text": "Paid. Only face to face."
    },
    {
      "id": "v11",
      "gap": 0.45,
      "text": "No signal? Still paid."
    },
    {
      "id": "v12",
      "gap": 0.25,
      "text": "Right inside Vinted and OLX."
    },
    {
      "id": "v13",
