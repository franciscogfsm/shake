# SHAKE runs on Stellar testnet. `npm run dev` fills .env.local for you on first run
# (scripts/setup.mjs: throwaway testnet accounts + test currencies, no Rust or Stellar CLI needed).
# Copy this file to .env.local only if you want to fill it by hand. Never commit .env.local.

NEXT_PUBLIC_NETWORK=testnet
# The public SHAKE deal contract (no admin: any test token can be locked in it)
NEXT_PUBLIC_DEAL_CONTRACT_ID=CAQ6KAVIUSXSO2A6T44TC6USH3WP67R7YYORMLMLVTRG6ZDBHGQIZ2JW
# Test currencies (Stellar Asset Contracts) from your own issuer
NEXT_PUBLIC_TOKEN_CONTRACT_ID=
NEXT_PUBLIC_TOKEN_EUR=
NEXT_PUBLIC_TOKEN_USD=
NEXT_PUBLIC_TOKEN_GBP=
NEXT_PUBLIC_TOKEN_BRL=
NEXT_PUBLIC_TOKEN_ISSUER=
# The pitch's seller account
NEXT_PUBLIC_TEAM_ADDRESS=

# Server-only secrets (testnet keys)
ISSUER_SECRET=
SPONSOR_SECRET=
TEAM_SECRET=

# Optional
# OpenZeppelin Channels key for fee sponsorship; without it SHAKE submits through its own 24 channel accounts
CHANNELS_API_KEY=
# Canonical origin for social previews
NEXT_PUBLIC_SITE_URL=
# Nido passkey wallet (testnet); defaults to https://test.nido.fyi
NEXT_PUBLIC_NIDO_BASE=
